[gml_api]
module GMAppleIAPs;

// =============================================================================
// Enums
// =============================================================================

[global, bind = typed_gml]
enum AppleIAPProductsStatus : int32
{
    None = 0,
    Success = 1,
    EmptyProductIds = 2,
    Error = 3,
}

[global, bind = typed_gml]
enum AppleIAPPurchaseStatus : int32
{
    None = 0,
    Success = 1,
    UserCancelled = 2,
    Pending = 3,
    ProductNotFound = 4,
    Error = 5,
    Unknown = 6,
    VerificationFailed = 7,
}

[global, bind = typed_gml]
enum AppleIAPTransactionStatus : int32
{
    None = 0,
    Success = 1,
    InvalidTransactionId = 2,
    TransactionNotFound = 3,
    NoCurrentEntitlement = 4,
    NoLatestTransaction = 5,
    Error = 6,
    VerificationFailed = 7,
}

[global, bind = typed_gml]
enum AppleIAPSyncStatus : int32
{
    None = 0,
    Success = 1,
    Error = 2,
}

[global, bind = typed_gml]
enum AppleIAPProductType : int32
{
    Unknown = 0,
    Consumable = 1,
    NonConsumable = 2,
    NonRenewable = 3,
    AutoRenewable = 4,
}

[global, bind = typed_gml]
enum AppleIAPTransactionEnvironment : int32
{
    Unknown = 0,
    Xcode = 1,
    Sandbox = 2,
    Production = 3,
}

[global, bind = typed_gml]
enum AppleIAPTransactionOwnershipType : int32
{
    Unknown = 0,
    Purchased = 1,
    FamilyShared = 2,
}

[global, bind = typed_gml]
enum AppleIAPRevocationReason : int32
{
    None = 0,
    DeveloperIssue = 1,
    Other = 2,
    Unknown = 3,
}

// =============================================================================
// Native wrapper records
// =============================================================================

[global]
class `[[AppleIAPProduct]]` prototype Object
{
    [field] property id : string { get; set; }
    [field, type_hint = `AppleIAPProductType`]
    property type : int32 { get; set; }
    [field] property display_name : string { get; set; }
    [field] property description : string { get; set; }
    [field] property display_price : string { get; set; }
    [field] property price : real { get; set; }
    [field] property currency_code : string { get; set; }
}

[global]
class `[[AppleIAPTransaction]]` prototype Object
{
    // IDs are strings to avoid UInt64 precision loss in GML.
    [field] property id : string { get; set; }
    [field] property original_id : string { get; set; }
    [field] property web_order_line_item_id : string { get; set; }

    [field] property product_id : string { get; set; }
    [field, type_hint = `AppleIAPProductType`]
    property product_type : int32 { get; set; }
    [field] property subscription_group_id : string { get; set; }

    // Dates are milliseconds since Unix epoch. 0 means unavailable.
    [field] property purchase_date_ms : real { get; set; }
    [field] property original_purchase_date_ms : real { get; set; }
    [field] property expiration_date_ms : real { get; set; }
    [field] property revocation_date_ms : real { get; set; }
    [field] property signed_date_ms : real { get; set; }

    [field, type_hint = `AppleIAPRevocationReason`]
    property revocation_reason : int32 { get; set; }
    [field] property is_upgraded : bool { get; set; }
    [field, type_hint = `AppleIAPTransactionOwnershipType`]
    property ownership_type : int32 { get; set; }
    [field, type_hint = `AppleIAPTransactionEnvironment`]
    property environment : int32 { get; set; }
    [field] property app_account_token : string { get; set; }
    [field] property offer_id : string { get; set; }
}

// =============================================================================
// Operation result records
// =============================================================================

/// Metadata delivered as the first callback argument of apple_iap_products.
[global]
class `[[AppleIAPProductsResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint = `AppleIAPProductsStatus`]
    property status : int32 { get; set; }
    [field] property message : string { get; set; }
}

/// Metadata delivered as the first callback argument of apple_iap_product_purchase.
[global]
class `[[AppleIAPPurchaseResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint = `AppleIAPPurchaseStatus`]
    property status : int32 { get; set; }
    [field] property message : string { get; set; }
}

[global]
class `[[AppleIAPTransactionFinishResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint = `AppleIAPTransactionStatus`]
    property status : int32 { get; set; }
    [field] property message : string { get; set; }
}

/// Metadata delivered with one transaction.
[global]
class `[[AppleIAPTransactionResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint = `AppleIAPTransactionStatus`]
    property status : int32 { get; set; }
    [field] property message : string { get; set; }
}

/// Metadata delivered with a std::vector<AppleIAPTransaction>.
[global]
class `[[AppleIAPTransactionsResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint = `AppleIAPTransactionStatus`]
    property status : int32 { get; set; }
    [field] property message : string { get; set; }
}

[global]
class `[[AppleIAPSyncResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint = `AppleIAPSyncStatus`]
    property status : int32 { get; set; }
    [field] property message : string { get; set; }
}

// =============================================================================
// Init / transaction updates
// =============================================================================

/// Starts the StoreKit.Transaction.updates listener immediately.
/// callback(result: AppleIAPTransactionResult, transaction: AppleIAPTransaction?)
/// fires for every update. When no verified transaction exists, the optional
/// payload is omitted and the GML transaction parameter is undefined.
/// Calling apple_iap_init again replaces the previous listener callback.
[global, bind = typed_gml]
function apple_iap_init(callback: func): bool;

// =============================================================================
// Products / purchase
// =============================================================================

/// callback(result: AppleIAPProductsResult, products: std::vector<AppleIAPProduct>)
/// products is always present and may be empty.
[global, bind = typed_gml]
function apple_iap_products(
    [type_hint = `string[]`] products_id: gmval,
    callback: func
): unit;

/// callback(result: AppleIAPPurchaseResult, transaction: AppleIAPTransaction?)
/// transaction is undefined unless StoreKit returns a verified .success transaction.
/// result.success is true only when that verified transaction is delivered;
/// UserCancelled and Pending are non-error statuses with success = false.
[global, bind = typed_gml]
function apple_iap_product_purchase(product_id: string, callback: func): unit;

// =============================================================================
// Transactions
// =============================================================================

/// transaction_id is string because StoreKit IDs are UInt64-sized.
/// callback(result: AppleIAPTransactionFinishResult).
/// A matching unverified transaction returns VerificationFailed and is never finished.
[global, bind = typed_gml]
function apple_iap_transaction_finish(transaction_id: string, callback: func): unit;

/// callback(result: AppleIAPTransactionResult, transaction: AppleIAPTransaction?)
/// When no verified transaction is available, the optional payload is omitted
/// and the GML transaction parameter is undefined.
[global, bind = typed_gml]
function apple_iap_transactions_current_entitlement(product_id: string, callback: func): unit;

/// callback(result: AppleIAPTransactionsResult, transactions: std::vector<AppleIAPTransaction>)
/// transactions is always present and may be empty. If one or more entries fail
/// verification, result is VerificationFailed/success=false while every verified
/// transaction collected from the sequence is still returned.
[global, bind = typed_gml]
function apple_iap_transactions_current_entitlements(callback: func): unit;

/// callback(result: AppleIAPTransactionResult, transaction: AppleIAPTransaction?)
/// When no verified transaction is available, the optional payload is omitted
/// and the GML transaction parameter is undefined.
[global, bind = typed_gml]
function apple_iap_transactions_latest(product_id: string, callback: func): unit;

/// callback(result: AppleIAPTransactionsResult, transactions: std::vector<AppleIAPTransaction>)
/// transactions is always present and may be empty. If one or more entries fail
/// verification, result is VerificationFailed/success=false while every verified
/// transaction collected from the sequence is still returned.
[global, bind = typed_gml]
function apple_iap_transactions_unfinished(callback: func): unit;

/// callback(result: AppleIAPTransactionsResult, transactions: std::vector<AppleIAPTransaction>)
/// transactions is always present and may be empty. If one or more entries fail
/// verification, result is VerificationFailed/success=false while every verified
/// transaction collected from the sequence is still returned.
[global, bind = typed_gml]
function apple_iap_transactions_all(callback: func): unit;

// =============================================================================
// Synchronization
// =============================================================================

/// callback(result: AppleIAPSyncResult).
[global, bind = typed_gml]
function apple_iap_synchronize(callback: func): unit;
